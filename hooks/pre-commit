#!/usr/bin/env bash
# job-search-os pre-commit scrub gate
# Per JOBS-ADR-003 D1a/D1b/D6/D10a. Runs on every commit in every user's instance —
# this is the mechanism that keeps `profile/` (real comp figures, employer names, search
# status) out of a repo that may later be pushed to a public remote.
#
# This is a CHECK, not a convention. Rev 1 of the design proposed "define constraints once"
# as an unenforced norm — that exact pattern already failed in the source workspace this
# tool was built from (location rules and comp floor both drifted across multiple files
# despite an ADR saying "single source of truth"). D6 requires a check; this is it.
#
# Installed by scripts/setup.sh (git does not track .git/hooks, so this file is the source
# of truth and setup.sh copies it into place — see D1a).

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

FAIL=0
STAGED=$(git diff --cached --name-only --diff-filter=ACM)

# ---- D1b: categorical refusal — profile/*.md (real data) is NEVER staged, ----
# ---- even via `git add -f`. Only *.template.md files may be committed.    ----
for f in $STAGED; do
  case "$f" in
    profile/*.md)
      case "$f" in
        profile/*.template.md) : ;; # allowed — this is the shipped template, not real data
        *)
          echo "🔴 BLOCKED: $f matches profile/*.md and is not a .template.md file."
          echo "   profile/ holds real user data (comp, employer names, search status) and"
          echo "   must never be committed. If this is genuinely a new template file, name"
          echo "   it *.template.md."
          FAIL=1
          ;;
      esac
      ;;
    roles/active/*.md|roles/passed/*.md)
      echo "🔴 BLOCKED: $f — roles/active and roles/passed hold real evaluation data and are"
      echo "   never committed to this repo."
      FAIL=1
      ;;
  esac
done

# ---- D15/D10a scrub list: currency figures, common comp-band shapes, and a few ----
# ---- structural fingerprints. Mechanical and intentionally broad — false        ----
# ---- positives cost a re-commit; false negatives cost a public disclosure.      ----
if [ -n "$STAGED" ]; then
  HITS=$(git diff --cached -U0 -- $STAGED 2>/dev/null | grep -E '^\+' | grep -vE '^\+\+\+' | grep -inE \
    -e '\$[0-9]{2,3}(,[0-9]{3})?[Kk]?[ -]?[-–—][ -]?\$?[0-9]{2,3}(,[0-9]{3})?[Kk]?' \
    -e '\$[0-9]{3},[0-9]{3}' \
    -e '[0-9]{3}-[0-9]{3}-[0-9]{4}' \
    -e '[a-zA-Z0-9._%+-]+@(gmail|yahoo|hotmail|outlook|icloud)\.com' \
    -e 'linkedin\.com/in/[a-zA-Z0-9-]+' \
    || true)
  if [ -n "$HITS" ]; then
    echo "🔴 BLOCKED: staged content matches the scrub list (currency range, phone, personal"
    echo "   email, or LinkedIn URL). This repo ships zero personal values — see JOBS-ADR-003 D1."
    echo
    echo "$HITS" | head -20
    echo
    echo "   If this is a false positive (e.g. a documentation example), rewrite it to use an"
    echo "   obviously fake placeholder (\$XXX,XXX, name@example.com) instead."
    FAIL=1
  fi
fi

if [ "$FAIL" -eq 1 ]; then
  echo
  echo "Commit blocked by hooks/pre-commit. Fix the above and re-commit."
  exit 1
fi

exit 0
